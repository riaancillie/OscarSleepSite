{
    "routes": [
        {
            "route": "/view*",
            "rewrite": "/view.html"
        },
        {
            "route": "/view/*",
            "rewrite": "/view.html"
        },
        {
            "route": "/upload*",
            "rewrite": "/upload.html"
        },
        {
            "route": "/verify*",
            "rewrite": "/verify.html"
        },
        {
            "route": "/verify/*",
            "rewrite": "/verify.html"
        },
        {
            "route": "/",
            "redirect": "https://www.sleepfiles.com/OSCAR/"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html"
    },
    "globalHeaders": {
        "Cache-Control": "no-cache, no-store"
    }
}