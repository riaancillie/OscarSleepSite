{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "configurations": {
    "oscar-sleep-site": {
      "appLocation": "wwwroot",
      "apiLocation": "api",
      "outputLocation": ".",
      "apiLanguage": "dotnetisolated",
      "apiVersion": "6.0",
      "apiBuildCommand": "dotnet publish -c Release",
      "host": "0.0.0.0",
      "env": {
        "STORAGE_CONNECTION_STRING": "1243"
      }      
    }
  }
}